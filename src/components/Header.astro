---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header>
    <nav>
        <div class="title">
            <a href="/">
                <img width="32" height="32" src="/logo.png" alt="">
            </a>
            <!--<h2><a href="/">{SITE_TITLE}</a></h2>-->
        </div>
        <div class="internal-links">
            <HeaderLink href="/">Overview</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
            <HeaderLink href="/docs">Help</HeaderLink>
        </div>
        <div class="social-links">
            <a href="https://github.com/InterShare" target="_blank">
                <span class="sr-only">Go to InterShare's GitHub repo</span>
                <svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
                ><path
                        fill="currentColor"
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                ></path></svg
                >
            </a>
        </div>
    </nav>
</header>
<style lang="scss">
    :root {
        --background: hsla(0,0%,100%,.72);
        --material-filters: saturate(180%) blur(20px);
        --material-separator-color: rgba(0,0,0,.16);
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --background: rgba(29, 29, 31, 0.72);
            --material-filters: saturate(180%) blur(20px);
            --material-separator-color: hsla(0,0%,100%,.10);
        }
    }


    header {
        position: fixed;
        /*padding: 0 1em;*/
        background: var(--background);
        backdrop-filter: var(--material-filters);
        -webkit-backdrop-filter: var(--material-filters);
        border: 1px solid var(--material-separator-color);
        left: 50%;
        transform: translateX(-50%);
        border-radius: 20px;
        margin-top: 10px;
        z-index: 9999;
        width: 80%;
        max-width: 400px;
        padding: 10px 20px;
    }

    .title {
        display: flex;
        align-items: center;
    }


    h2 {
        margin: 0;
        font-size: 1em;
    }

    h2 a,
    h2 a.active {
        text-decoration: none;
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    nav a {
        display: inline;
        padding: 0 0.4em;
        color: var(--black);
        text-decoration: none;
    }

    .title a {
        display: flex;
    }

    nav a.active {
        text-decoration: none;
    }
    .social-links,
    .social-links a {
        display: flex;
    }
    @media (max-width: 720px) {
        .social-links {
            display: none;
        }
    }
</style>
